# Copy this file to ".env" next to docker-compose.yml on the server and fill it in. The real file is never committed.

DB_CONNECTION=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
OPENROUTER_API_KEY=
JINA_API_KEY=

# The public address of the site. Only this origin may open the chat socket.
PUBLIC_ORIGIN=https://employeegrid.sajibofficial.me

# Optional (defaults shown)
# AGENT_LOG_LEVEL=INFO
